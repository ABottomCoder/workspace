# ---- page-chat-kit config ----
PORT=8790
# 32+ char random; if omitted a random one is generated each boot (sessions won't survive restart)
SESSION_SECRET=
# shared key the AGENT uses to post replies (reply.js / POST /_portal/api/chat/reply). keep secret.
AGENT_KEY=change-this-agent-key
# the AGENT (chat bot) account username — must exist in accounts.json with role "agent".
# Its `label` in accounts.json is the chat bot's display name (e.g. label "Rin").
# The agent account sees every thread (all private + group) and posts replies.
AGENT_USER=rin
# brand shown on the LOGIN page + portal header (Layer-1 page-access gate)
BRAND=Chat Portal
# set to 1 when served over public HTTPS (adds Secure cookie flag)
COOKIE_SECURE=0
# session cookie lifetime (ms). default 24h.
SESSION_MAX_AGE_MS=86400000
# max upload size (MB)
MAX_UPLOAD_MB=50

# ---- OPTIONAL: wrap an existing site (its own business login = Layer 2) behind the gate ----
# if FRONT_TARGET is set, all non-portal paths are reverse-proxied to it and shown in the shell iframe,
# BEHIND the Layer-1 page-access login. leave empty to run standalone (no site).
FRONT_TARGET=
# iframe initial path on the proxied site (e.g. / or /zh-CN)
FRAME_PATH=/

# ---- OPTIONAL: outbound DLP (scrub agent replies before they reach users) ----
# 1 = enable the generic AI-provider name filter (claude/gpt/anthropic/opus/...) on agent messages.
DLP_HIDE_AI_VENDORS=0
# comma-separated extra literal strings/regex fragments to block in agent outbound messages
DLP_EXTRA=
