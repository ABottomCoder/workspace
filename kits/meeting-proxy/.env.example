ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=

# The name colleagues use to address you in meetings (required)
USER_NAME=
# Optional: comma-separated words ASR tends to hear instead of your name (fed to the prompt)
NAME_SOUNDALIKES=

# group = respond only when addressed by name; 1on1 = treat every question as addressed to you
MEETING_MODE=group

# TTS provider: "deepgram" (default, no extra signup) or "elevenlabs" (voice clone)
TTS_PROVIDER=deepgram
# See https://developers.deepgram.com/docs/tts-models (aura-2-thalia-en, aura-2-orion-en, ...)
DEEPGRAM_TTS_MODEL=aura-2-thalia-en

# Only when TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_SPEED=0.9

# Audio devices (run `npm run list-devices` to see exact names)
AUDIO_INPUT_DEVICE=BlackHole 16ch
AUDIO_OUTPUT_DEVICE=BlackHole 2ch
# Where you hear the meeting; the launcher sets this from your previous output device
PASSTHROUGH_DEVICE=
