#!/bin/bash
# Work items: projects (business/<co>/<project>/DEVDOC.md | .state/DEVDOC.md | docs/HANDOFF.md) and tickets
# (business/<co>/tickets/<ID>/ or user/work/<slug>/: STATE.md, LOG.md, handoff/<role>.md, HANDOFF.md index).
# A session is bound to one work item, with a role (default main); `work restore` re-injects it.
# Formats and conventions: tools/work/README.md.
#
#   work attach <target> [--role <r>]            bind THIS session to a work item (role kept on re-attach)
#   work new-ticket <business|user> <ID> "title" [project]   create a ticket (user -> user/work/<ID>)
#   work log [<target>] "msg"                    ticket: append to LOG.md; project: state-file change log
#   work handoff [<target>] [--role <r>]         ticket: create/archive handoff/<role>.md, rebuild HANDOFF.md
#   work rename <target> <new ID | new target>   ticket: move the dir, rebind its sessions
#   work close <target> | reopen <target>        ticket: status closed + move to _archive/ (and back)
#   work show                                    what this session is bound to
#   work index <business>                        regenerate business/<co>/tickets/INDEX.md
#   work restore                                 SessionStart hook (reads hook JSON on stdin)
#   work snapshot                                PreCompact hook: git state -> user/sessions/.snapshots/<sid>.md
#
# <target>: <business>/<project> | <business>/tickets/<ID>[/<sub>] | user/work/<slug>[/<sub>]  (a
# leading "business/" is accepted). Omitted <target> = the item this session is bound to.
set -u
HERE="$(cd "$(dirname "$0")" && pwd)"
ROOT="${WORK_ROOT:-$(cd "$HERE/../.." && pwd)}"        # WORK_ROOT: tests only
. "$HERE/../lib/cc-internals.sh"
BIND="$ROOT/user/sessions/.bindings"
LOG_LIMIT="${WORK_LOG_LIMIT:-300}"
SNAP="$ROOT/user/sessions/.snapshots"
PARALLEL_MIN="${WORK_PARALLEL_MIN:-120}"   # another session bound to the same ticket counts as live if its transcript moved this recently
LIB="$HERE/lib_handoff.py"
die() { echo "work: $*" >&2; exit 1; }
stamp() { date -u +%Y-%m-%dT%H:%MZ; }
today() { date +%Y-%m-%d; }

# Resolve a target to its relative path (REL) and kind (KIND = project | ticket).
resolve() {
  local t="${1%/}"
  t="${t#business/}"
  case "$t" in ""|/*|*..*) die "bad target '$1'";; esac
  case "$t" in
    user/work/*)   REL="$t"; KIND=ticket ;;
    */tickets/*/*/*) die "bad target '$1' (sub-items are one level deep)" ;;
    */tickets/*)   REL="business/$t"; KIND=ticket ;;
    */*/*)         die "bad target '$1' (use <business>/<project> or <business>/tickets/<ID>)" ;;
    */*)           REL="business/$t"; KIND=project ;;
    *)             die "bad target '$1' (use <business>/<project>, <business>/tickets/<ID> or user/work/<slug>)" ;;
  esac
  DIR="$ROOT/$REL"
}

sid() { cc_current_session_id "$(cc_transcript_dir "$ROOT")"; }

live_peers() {   # $1 own session id, $2 target REL, $3 role: short ids of other sessions bound to it with that role whose transcript moved within PARALLEL_MIN
  local f o tdir out=""; tdir=$(cc_transcript_dir "$ROOT")
  [ -d "$BIND" ] || return 0
  for f in "$BIND"/*; do
    [ -f "$f" ] || continue; o=$(basename "$f"); [ "$o" = "$1" ] && continue
    [ "$(sed -n 's/^target=//p' "$f" | head -1)" = "$2" ] || continue
    [ "$(role_of "$f")" = "$3" ] || continue
    [ -n "$(find "$tdir/$o.jsonl" -mmin -"$PARALLEL_MIN" 2>/dev/null)" ] && out="$out${out:+ }${o:0:8}"
  done
  printf '%s' "$out"
}

bound() {   # print the bound target of this session, or fail
  local s; s=$(sid) || return 1
  [ -f "$BIND/$s" ] || return 1
  sed -n 's/^target=//p' "$BIND/$s" | head -1
}

role_of() { local r; r=$(sed -n 's/^role=//p' "$1" 2>/dev/null | head -1); echo "${r:-main}"; }   # $1 binding file
bound_role() { local s; s=$(sid 2>/dev/null) && role_of "$BIND/$s" || echo main; }
check_role() { [[ "$1" =~ ^[a-z0-9][a-z0-9_-]*$ ]] || die "bad role '$1' (lowercase letters, digits, _ -)"; }
# Role for <target>: --role, else this session's role when <target> is its bound item, else main.
role_for() { if [ -n "$1" ]; then echo "$1"; elif [ "$(bound 2>/dev/null)" = "$REL" ]; then bound_role; else echo main; fi; }

rebind() {   # $1 old REL, $2 new REL: retarget every binding on $1 or a sub-item of it
  [ -d "$BIND" ] || return 0
  python3 - "$BIND" "$1" "$2" <<'PY'
import os, sys
b, old, new = sys.argv[1:4]
for f in os.listdir(b):
    p = os.path.join(b, f)
    if not os.path.isfile(p): continue
    ls = open(p, encoding="utf-8").read().splitlines()
    out = ["target=" + new + l[7 + len(old):] if l.startswith("target=") and (l[7:] == old or l[7:].startswith(old + "/")) else l for l in ls]
    if out != ls: open(p, "w", encoding="utf-8").write("\n".join(out) + "\n")
PY
}

target_or_bound() { if [ -n "${1:-}" ]; then resolve "$1"; else local b; b=$(bound) || die "no target given and this session is not attached (work attach <target>)"; resolve "$b"; fi; }

# Project live-state file: DEVDOC.md (local, gitignored), .state/DEVDOC.md (orphan-branch worktree, for repos whose
# state must not reach main), docs/HANDOFF.md (committed, personal repos). Helpers shared with tools/rollover.
. "$HERE/../lib/state.sh"
STATE_FILES="$WORK_STATE_FILES"

need_ticket() { [ "$KIND" = ticket ] || die "$REL is a project; projects keep state in $(state_file "$DIR" || echo DEVDOC.md)"; [ -f "$DIR/STATE.md" ] || [ -f "$DIR/LOG.md" ] || die "no ticket at $REL (work new-ticket ...)"; }

# Fill a template (templates/ticket/*, templates/project/DEVDOC.md): front-matter keys id, title,
# project, opened, updated are set; body placeholders <id> <title> <Project> <YYYY-MM-DD> replaced.
fill() { python3 - "$@" <<'PY2'
import re, sys
src, dst, id_, title, project, date = sys.argv[1:7]
t = open(src, encoding="utf-8").read()
fm, body = "", t
if t.startswith("---\n") and t.find("\n---", 4) > 0:
    e = t.find("\n---", 4); fm, body = t[:e], t[e:]
    for k, v in {"id": id_, "title": title, "project": project or "none", "opened": date, "updated": date}.items():
        fm = re.sub(r"(?m)^(%s:)[ \t]*[^#\n]*?([ \t]*#.*)?$" % k, lambda m: m.group(1) + " " + v + (("   " + m.group(2).strip()) if m.group(2) else ""), fm)
for k, v in {"<id>": id_, "<title>": title, "<Project>": id_, "<YYYY-MM-DD>": date}.items():
    body = body.replace(k, v)
open(dst, "w", encoding="utf-8").write(fm + body)
PY2
}

state_title() { [ -f "$1/STATE.md" ] && sed -n 's/^title:[[:space:]]*//p' "$1/STATE.md" | head -1; }

cmd_attach() {
  local tgt="" role=""
  while [ $# -gt 0 ]; do case "$1" in --role) role=${2:-}; shift 2 || shift;; *) tgt=$1; shift;; esac; done
  [ -n "$tgt" ] || die "usage: work attach <target> [--role <r>]"
  resolve "$tgt"
  local s; s=$(sid) || die "no session id (run from a Claude Code Bash call)"
  if [ -z "$role" ]; then   # re-attaching to the same item keeps the role
    if [ -f "$BIND/$s" ] && [ "$(sed -n 's/^target=//p' "$BIND/$s" | head -1)" = "$REL" ]; then role=$(role_of "$BIND/$s"); else role=main; fi
  fi
  check_role "$role"
  if [ "$KIND" = project ]; then
    [ -d "$DIR" ] || die "no project dir $REL"
    local pol; pol=$(state_policy "$ROOT" "$(echo "$REL" | cut -d/ -f2)")
    if ! state_file "$DIR" >/dev/null && [ "$pol" = in-repo ]; then
      mkdir -p "$DIR/docs"
      printf '# %s — handoff\n\n## Current state\n\n## Change log\n\n## Session log (newest first)\n' "$(basename "$DIR")" > "$DIR/docs/HANDOFF.md"
      echo "created $REL/docs/HANDOFF.md (business state policy: in-repo)"
    elif ! state_file "$DIR" >/dev/null && [ "$pol" = orphan ]; then
      local prev; prev=$(bound 2>/dev/null) || prev="nothing"
      die "business state policy is orphan branch: set up $REL/.state first (tools/work/README.md -> Project state policy); still attached to $prev"
    fi
    if ! state_file "$DIR" >/dev/null; then
      if [ -f "$ROOT/templates/project/DEVDOC.md" ]; then fill "$ROOT/templates/project/DEVDOC.md" "$DIR/DEVDOC.md" "$(basename "$DIR")" "" "" "$(today)"
      else printf '# %s — dev doc\n\n## State\n\n## Active work\n\n## TODO\n\n## Change log\n\n## Reference\n' "$(basename "$DIR")" > "$DIR/DEVDOC.md"; fi
      echo "created $REL/DEVDOC.md"
      if git -C "$DIR" rev-parse --git-dir >/dev/null 2>&1 && ! git -C "$DIR" check-ignore -q DEVDOC.md; then
        echo "note: DEVDOC.md is not gitignored in this repo; add it to $REL/.gitignore" >&2
      fi
    fi
  else
    [ -d "$DIR" ] || die "no ticket dir $REL (work new-ticket ...)"
    echo "$(stamp) session ${s:0:8} attached (role $role)" >> "$DIR/LOG.md"
    local others; others=$(live_peers "$s" "$REL" "$role")
    [ -n "$others" ] && echo "warning: session(s) $others are live on $REL with the same role '$role'; both would edit handoff/$role.md (attach with --role <other> if the work differs)" >&2
  fi
  mkdir -p "$BIND"; printf 'target=%s\nrole=%s\nattached=%s\n' "$REL" "$role" "$(stamp)" > "$BIND/$s"
  local desc; desc=$(basename "$REL" | tr '_ ' '--')
  echo "attached ${s:0:8} -> $REL (role $role)"
  [ "$KIND" = ticket ] && echo "your handoff: $REL/handoff/$role.md (only this role's file; tools/work/handoff creates it)"
  echo "session name convention: ${desc}_<app|None>_<n>  (e.g. ${desc}_None_1; set with /rename)"
}

cmd_new_ticket() {
  local b="${1:-}" id="${2:-}" title="${3:-}" project="${4:-}"
  [ -n "$b" ] && [ -n "$id" ] && [ -n "$title" ] || die "usage: work new-ticket <business> <ID> \"title\" [project]"
  # One optional sub-level ("26AUG-p0/274") splits a batch ticket so a session attaches to its part only.
  case "$id" in */*/*|.*|*/.*|/*|*/|*" "*) die "ID must not contain spaces, start with '.', or nest deeper than <ID>/<sub>";; esac
  local d rel
  if [ "$b" = user ]; then rel="user/work/$id"; else
    [ -d "$ROOT/business/$b" ] || die "no business dir business/$b"; rel="business/$b/tickets/$id"; fi
  d="$ROOT/$rel"
  [ -e "$d" ] && die "ticket exists: $rel"
  case "$id" in */*) [ -d "$(dirname "$d")" ] || die "no parent ticket $(dirname "$rel")";; esac
  mkdir -p "$d/history" "$d/reports" "$d/evidence"
  local tpl="$ROOT/templates/ticket" f
  for f in STATE.md LOG.md; do
    [ -f "$tpl/$f" ] && fill "$tpl/$f" "$d/$f" "$id" "$title" "$project" "$(today)"
  done
  [ -f "$d/STATE.md" ] || cat > "$d/STATE.md" <<EOF
---
id: $id
title: $title
status: open            # open | active | review | blocked | closed
project: ${project:-none}
opened: $(today)
updated: $(today)
closed:
---

# $id: $title

## Links

## Acceptance criteria
EOF
  [ -f "$d/LOG.md" ] || printf '# %s — log\n\nAppend-only, one line per thing a successor must know: what changed, what was\ndecided and why, what was sent to whom, what failed. Not: files read, raw output, thinking.\n\n' "$id" > "$d/LOG.md"
  python3 "$LIB" index "$ROOT" "$rel"
  echo "$(stamp) created: $title" >> "$d/LOG.md"
  echo "new ticket: $rel"
}

# Bump `updated:` in STATE.md front matter (no-op without front matter).
touch_state() { [ -f "$1/STATE.md" ] && python3 - "$1/STATE.md" "$(today)" <<'PY'
import re, sys
p, d = sys.argv[1:3]
t = open(p, encoding="utf-8").read()
if t.startswith("---\n"):
    end = t.find("\n---", 4)
    if end > 0:
        fm = t[:end]
        fm2 = re.sub(r"(?m)^updated:.*$", "updated: " + d, fm) if re.search(r"(?m)^updated:", fm) else fm + "\nupdated: " + d
        open(p, "w", encoding="utf-8").write(fm2 + t[end:])
PY
}

cmd_log() {
  local t msg
  if [ $# -ge 2 ]; then t="$1"; msg="$2"; else t=""; msg="${1:-}"; fi
  [ -n "$msg" ] || die "usage: work log [<target>] \"msg\""
  target_or_bound "$t"
  msg=$(printf '%s' "$msg" | tr '\n' ' ')
  if [ "$KIND" = ticket ]; then
    need_ticket
    local role; role=$(role_for "")   # non-main roles tag their lines, so restore can tell whose they are
    [ "$role" != main ] && [ "${msg#\[$role\]}" = "$msg" ] && msg="[$role] $msg"
    printf '%s %s\n' "$(stamp)" "$msg" >> "$DIR/LOG.md"
    touch_state "$DIR"
    local n; n=$(wc -l < "$DIR/LOG.md" | tr -d ' ')
    [ "$n" -gt "$LOG_LIMIT" ] && echo "work: LOG.md has $n lines (> $LOG_LIMIT). Move older lines to history/log-<date>.md and leave a digest at the top." >&2
  else
    local sf; sf=$(state_file "$DIR") || die "no state file in $REL ($STATE_FILES; work attach creates DEVDOC.md)"
    python3 - "$DIR/$sf" "$(today) $msg" <<'PY'
import re, sys
p, line = sys.argv[1:3]
t = open(p, encoding="utf-8").read()
m = re.search(r"(?mi)^##+\s*(\d+\.\s*)?change ?log.*\n", t)
if m:   # newest first: right under the heading (after an optional blank line)
    i = m.end()
    nxt = re.search(r"(?m)^#", t[i:])
    end = i + nxt.start() if nxt else len(t)
    # drop the empty template bullet ("- <YYYY-MM-DD>" or a bare "- <date>"), only inside this section
    sec = re.sub(r"(?m)^- (<YYYY-MM-DD>|\d{4}-\d{2}-\d{2})[ \t]*\n", "", t[i:end])
    t = t[:i] + sec + t[end:]
    if t[i:i+1] == "\n": i += 1
    t = t[:i] + "- " + line + "\n" + ("\n" if t[i:i+1] == "#" else "") + t[i:]
else:   # new section near the top (after the H1) so restore's head-first budget keeps it
    i, fence, pos = 0, False, 0   # after the first H1 outside code fences, else after front matter
    if t.startswith("---\n") and t.find("\n---", 4) > 0:
        e = t.find("\n", t.find("\n---", 4) + 1)
        i = e + 1 if e >= 0 else len(t)
    for ln in t.splitlines(True):
        if ln.lstrip().startswith("```"): fence = not fence
        elif not fence and ln.startswith("# "): i = pos + len(ln); break
        pos += len(ln)
    t = t[:i] + "\n## Change log\n\n- " + line + "\n" + t[i:]
open(p, "w", encoding="utf-8").write(t)
PY
  fi
  exit 0
}

cmd_handoff() {
  local tgt="" role=""
  while [ $# -gt 0 ]; do case "$1" in --role) role=${2:-}; shift 2 || shift;; *) tgt=$1; shift;; esac; done
  target_or_bound "$tgt"; need_ticket
  role=$(role_for "$role"); check_role "$role"
  python3 "$LIB" handoff "$ROOT" "$REL" "$role" "$ROOT/templates/ticket/handoff-role.md"
}

# Ticket front matter: set status (+ closed date when closing).
set_status() { python3 - "$1/STATE.md" "$2" "$(today)" <<'PY'
import re, sys
p, st, d = sys.argv[1:4]
t = open(p, encoding="utf-8").read()
for k, v in (("status", st), ("closed", d if st == "closed" else ""), ("updated", d)):
    t = re.sub(r"(?m)^(%s:)[ \t]*[^#\n]*?([ \t]*#.*)?$" % k, lambda m: m.group(1) + (" " + v if v else "") + (("   " + m.group(2).strip()) if m.group(2) else ""), t, count=1)
open(p, "w", encoding="utf-8").write(t)
PY
}

move_item() {   # $1 old REL, $2 new REL: move a ticket dir, rebind its sessions, log, rebuild the index
  [ -e "$ROOT/$2" ] && die "exists: $2"
  [ -d "$(dirname "$ROOT/$2")" ] || mkdir -p "$(dirname "$ROOT/$2")"
  mv "$ROOT/$1" "$ROOT/$2"; rebind "$1" "$2"
  echo "$(stamp) moved from $1 to $2" >> "$ROOT/$2/LOG.md"
  python3 "$LIB" index "$ROOT" "$2"
  echo "moved $1 -> $2"
}

cmd_rename() {
  [ -n "${1:-}" ] && [ -n "${2:-}" ] || die "usage: work rename <target> <new ID | new target>"
  resolve "$1"; need_ticket; local old=$REL
  case "$2" in */*) resolve "$2" ;; *) case "$2" in .*|*" "*) die "bad ID '$2'";; esac; REL="$(dirname "$old")/$2"; KIND=ticket ;; esac
  [ "$KIND" = ticket ] || die "rename target must be a ticket or user/work item"
  move_item "$old" "$REL"
}

cmd_close() {
  [ -n "${1:-}" ] || die "usage: work close <target>"
  resolve "$1"; need_ticket; set_status "$DIR" closed
  echo "$(stamp) closed" >> "$DIR/LOG.md"
  local p; p=$(basename "$(dirname "$DIR")")
  if [ "$p" = tickets ] || [ "$p" = work ]; then move_item "$REL" "$(dirname "$REL")/_archive/$(basename "$REL")"
  else python3 "$LIB" index "$ROOT" "$REL"; echo "closed sub-item $REL (stays under its parent)"; fi
}

cmd_reopen() {
  [ -n "${1:-}" ] || die "usage: work reopen <target>"
  resolve "$1"; need_ticket
  [ "$(basename "$(dirname "$DIR")")" = _archive ] || die "$REL is not archived"
  local to; to="$(dirname "$(dirname "$REL")")/$(basename "$REL")"
  set_status "$DIR" active; move_item "$REL" "$to"
}

cmd_show() {
  local b; b=$(bound) || die "this session is not attached (work attach <target>)"
  resolve "$b"
  if [ "$KIND" = ticket ]; then
    echo "ticket $REL  (LOG.md $(wc -l < "$DIR/LOG.md" 2>/dev/null | tr -d ' ') lines)"
  else
    echo "project $REL  (state: $(state_file "$DIR" || echo 'missing'))"
  fi
}

cmd_index() {
  local b="${1:-}"; [ -n "$b" ] || die "usage: work index <business>"
  local d="$ROOT/business/$b/tickets"; [ -d "$d" ] || die "no business/$b/tickets"
  python3 - "$d" <<'PY'
import os, re, sys, datetime
d = sys.argv[1]
KEYS = ("id", "title", "status", "project", "updated")
rows = []
arch = os.path.join(d, "_archive")
names = sorted(os.listdir(d)) + (["_archive/" + n for n in sorted(os.listdir(arch))] if os.path.isdir(arch) else [])
for name in names:
    p = os.path.join(d, name, "STATE.md")
    if not os.path.isfile(p): continue
    t = open(p, encoding="utf-8", errors="replace").read()
    f = {}
    if t.startswith("---\n") and t.find("\n---", 4) > 0:
        for l in t[4:t.find("\n---", 4)].splitlines():
            m = re.match(r"\s*([A-Za-z_]+)\s*:\s*(.*?)\s*(#.*)?$", l)
            if m and m.group(1).lower() in KEYS: f[m.group(1).lower()] = m.group(2)
    else:   # header lines: "Status: x", "- **Status:** x"
        for l in t.splitlines()[:40]:
            m = re.match(r"[\s>*-]*\**([A-Za-z]+)\**\s*:\s*\**\s*(.+?)\s*$", l)
            if m and m.group(1).lower() in KEYS and m.group(1).lower() not in f: f[m.group(1).lower()] = m.group(2).strip("* ")
    if "title" not in f:
        h = re.search(r"(?m)^#\s+(.+)$", t); f["title"] = h.group(1) if h else ""
    f.setdefault("updated", datetime.date.fromtimestamp(os.path.getmtime(p)).isoformat())
    f["id"] = name   # the dir name is the ID
    rows.append(f)
cell = lambda s: (s or "").replace("|", "/")
order = {"active": 0, "open": 1, "blocked": 2, "review": 3, "closed": 9}
rows.sort(key=lambda r: r.get("updated", ""), reverse=True)
rows.sort(key=lambda r: order.get(r.get("status", "").lower(), 5))
biz = os.path.basename(os.path.dirname(os.path.abspath(d)))
out = ["# Tickets — " + biz, "",
       "> **Generated** by `tools/work/index` — do not edit by hand; edit each ticket's `STATE.md` and regenerate.",
       "> One directory per ticket: the ticket-system ID (`ABC-18`, `2233`), or a short kebab description if none.", "",
       "| ID | Title | Status | Project | Updated |", "|---|---|---|---|---|"]
out += ["| [%s](%s/STATE.md) | %s | %s | %s | %s |" % (cell(r["id"]), r["id"], cell(r.get("title")),
        cell(r.get("status")), cell("" if r.get("project") == "none" else r.get("project")), cell(r.get("updated"))) for r in rows]
open(os.path.join(d, "INDEX.md"), "w", encoding="utf-8").write("\n".join(out) + "\n")
print("wrote tickets/INDEX.md (%d tickets)" % len(rows))
PY
}

cmd_restore() {
  local input s src target
  input=$(cat)
  s=$(printf '%s' "$input" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("session_id",""))' 2>/dev/null)
  src=$(printf '%s' "$input" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("source",""))' 2>/dev/null)
  target=""; [ -n "$s" ] && [ -f "$BIND/$s" ] && target=$(sed -n 's/^target=//p' "$BIND/$s" | head -1)
  if [ -z "$target" ] || ! ( resolve "$target" ) >/dev/null 2>&1; then
    python3 -c 'import json; print(json.dumps({"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext":
      "[work] Not attached to a work item. Before real work: route the request (main CLAUDE.md -> Routing), then run `tools/work/work attach <business>/<project> | <business>/tickets/<ID> | user/work/<slug>`."}}))'
    exit 0
  fi
  resolve "$target"
  python3 - "$ROOT" "$REL" "$KIND" "$src" "$s" "$SNAP" "$(role_of "$BIND/$s")" "$HERE" <<'PY'
import json, os, re, sys, datetime
root, rel, kind, src, sid, snapdir, role, here = sys.argv[1:9]
sys.path.insert(0, here); import lib_handoff as H
d = os.path.join(root, rel)
read = lambda p: open(p, encoding="utf-8", errors="replace").read() if os.path.exists(p) else ""
BUDGET = 9500                                   # additionalContext is capped at 10,000 chars
cut = lambda s, n, p: s if len(s) <= n else s[:n] + f"\n…(truncated: read {p})"
parts = rel.split("/")
biz = f"business/{parts[1]}/CLAUDE.md" if parts[0] == "business" else None
head = (f"[work restore on {src or 'session start'}] This session is attached to {kind} {rel}. "
        "What follows is the work item's own record: trust it over a compacted summary; before saying "
        "whether something was done, check the log, git or the conversation, never memory alone. "
        + (f"Business rules: {biz}. " if biz else "")
        + ("Keep the project state file current (state, TODO, change log: `tools/work/log \"…\"`).\n\n" if kind == "project"
           else f"Your role is '{role}': edit only handoff/{role}.md (in place), then `tools/work/handoff`. "
                "Keep logging: `tools/work/log \"…\"`.\n\n"))
# PreCompact snapshot of this session (git state at compaction), only right after a compaction.
snap = read(os.path.join(snapdir, sid + ".md")).strip() if src == "compact" and sid else ""
snap = ("## Pre-compaction snapshot (this session)\n" + cut(snap, 1200, f"user/sessions/.snapshots/{sid}.md") + "\n\n") if snap else ""
if kind == "project":
    if os.path.exists(os.path.join(d, "CLAUDE.md")): head += f"Project knowledge: {rel}/CLAUDE.md.\n\n"
    sf = next((f for f in ("DEVDOC.md", ".state/DEVDOC.md", "docs/HANDOFF.md") if os.path.exists(os.path.join(d, f))), "DEVDOC.md")
    body = head + snap + f"## {sf}\n" + cut(read(os.path.join(d, sf)), BUDGET - len(head) - len(snap) - 20, f"{rel}/{sf}")
else:
    pd = os.path.dirname(d)   # a sub-item (<ID>/<sub>) points at its parent instead of inlining it
    if os.path.basename(pd) not in ("tickets", "work") and os.path.exists(os.path.join(pd, "STATE.md")):
        head += f"Sub-item of {os.path.relpath(pd, root)}: read its HANDOFF.md only for batch-wide facts.\n\n"
    rf = H.role_file(d, role)
    raw, label, warn = read(rf).strip(), f"handoff/{role}.md", []
    if not raw and H.legacy(d) and not H.roles(d):
        raw, label = H.legacy(d), "HANDOFF.md (legacy, single file)"
        warn.append("this item still has a single legacy HANDOFF.md: run `tools/work/handoff` to move it to handoff/main.md")
    if not raw:
        warn.append(f"no handoff/{role}.md yet: run `tools/work/handoff` at the next milestone and fill it")
    elif H.TEMPLATE_RE.search(raw):
        warn.append(f"{label} is still the empty template: fill it at the next milestone")
    elif raw.count("\n") + 1 > H.LIMIT:
        warn.append(f"{label} is {raw.count(chr(10)) + 1} lines: keep the resume point short and move detail to "
                    f"handoff/{role}/<topic>.md or reports/ with a pointer")
    log = read(os.path.join(d, "LOG.md")).rstrip("\n").split("\n")
    if raw and not warn and os.path.exists(rf):   # entries of this role written after its handoff
        hm, tag = H.utc(rf), f"[{role}] "
        mine = lambda b: b.startswith(tag) if role != "main" else not re.match(r"\[[\w-]+\] |session \w+ attached", b)
        newer = sum(1 for l in log if re.match(r"\d{4}-\d\d-\d\dT\d\d:\d\dZ ", l) and l[:17] > hm and mine(l[18:]))
        if newer >= 10: warn.append(f"{newer} LOG entries of role {role} since {label} was written: refresh it")
    if warn: head += "Handoff check: " + "; ".join(warn) + ".\n\n"
    others = [r for r in H.roles(d) if r != role]
    index = ("## Other roles (handoff index; read their file only if it touches your work)\n"
             + "\n".join(f"- {r} (handoff/{r}.md): {H.status(read(H.role_file(d, r)))}" for r in others) + "\n\n") if others else ""
    state = cut(read(os.path.join(d, "STATE.md")).strip(), 2500, f"{rel}/STATE.md")
    handoff = cut(raw, 3000, f"{rel}/{label.split(' ')[0]}")
    room = BUDGET - len(head) - len(snap) - len(index) - len(state) - len(handoff) - 200
    tail, used = [], 0
    for line in reversed(log):
        if used + len(line) + 1 > room: break
        tail.append(line); used += len(line) + 1
    tail.reverse()
    skipped = len(log) - len(tail)
    body = (head + snap + "## STATE.md\n" + state + "\n\n" + index + f"## Your handoff: {label}\n" + handoff + f"\n\n## LOG.md (last {len(tail)} lines"
            + (f"; {skipped} earlier lines in the file" if skipped else "") + ")\n" + "\n".join(tail))
print(json.dumps({"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": body[:BUDGET]}}))
PY
}

# PreCompact hook: record the mechanical state (time, trigger, git worktrees of the item's repo)
# per session, so restore can show it after compaction. Never blocks compaction; prints nothing.
cmd_snapshot() {
  local input s trig target repo=""
  input=$(cat)
  s=$(printf '%s' "$input" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("session_id",""))' 2>/dev/null)
  trig=$(printf '%s' "$input" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("trigger",""))' 2>/dev/null)
  [ -n "$s" ] && [ -f "$BIND/$s" ] || exit 0
  target=$(sed -n 's/^target=//p' "$BIND/$s" | head -1)
  ( resolve "$target" ) >/dev/null 2>&1 || exit 0
  resolve "$target"
  if [ "$KIND" = project ]; then repo="$DIR"; else
    local p f
    for f in "$DIR/STATE.md" "$(dirname "$DIR")/STATE.md"; do
      p=$(sed -n 's/^project:[[:space:]]*\([^ #]*\).*/\1/p' "$f" 2>/dev/null | head -1)
      case "$p" in ""|none|"<"*) continue ;; esac
      repo="$ROOT/business/$(echo "$REL" | cut -d/ -f2)/$p"; break
    done
  fi
  mkdir -p "$SNAP"
  python3 - "$ROOT" "$REL" "$repo" "$trig" "$SNAP/$s.md" <<'PY' || true
import os, subprocess, sys, datetime
root, rel, repo, trig, out = sys.argv[1:6]
read = lambda p: open(p, encoding="utf-8", errors="replace").read() if os.path.exists(p) else ""
d = os.path.join(root, rel)   # branches this item names (STATE, HANDOFF, recent LOG) come first
hd = os.path.join(d, "handoff")
named = (read(os.path.join(d, "STATE.md")) + read(os.path.join(d, "HANDOFF.md")) + "\n".join(read(os.path.join(d, "LOG.md")).splitlines()[-80:])
         + "".join(read(os.path.join(hd, f)) for f in (sorted(os.listdir(hd)) if os.path.isdir(hd) else []) if f.endswith(".md")))
git = lambda wd, *a: subprocess.run(["git", "-C", wd, *a], capture_output=True, text=True, timeout=5).stdout.strip()
now = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%MZ")
lines = [f"- {now} compaction ({trig or 'unknown trigger'}) of {rel}"]
if repo and os.path.isdir(repo) and git(repo, "rev-parse", "--git-dir"):
    rows = []
    for blk in git(repo, "worktree", "list", "--porcelain").split("\n\n"):
        kv = dict((l.split(" ", 1) + [""])[:2] for l in blk.splitlines() if l)
        wt = kv.get("worktree")
        if not wt or not os.path.isdir(wt): continue
        dirty = len([l for l in git(wt, "status", "--porcelain").splitlines() if l])
        ab = git(wt, "rev-list", "--left-right", "--count", "@{u}...HEAD").split()
        ahead = int(ab[1]) if len(ab) == 2 else None
        br = kv.get("branch", "").replace("refs/heads/", "")
        mine = bool(br) and br in named
        if not mine and not dirty and not ahead: continue   # clean and unrelated: noise
        rows.append((not mine, f"- {'*' if mine else ''}{os.path.relpath(wt, root)}: {kv.get('branch', 'detached').replace('refs/heads/', '')} "
                     f"@ {kv.get('HEAD', '')[:8]}" + (f", {dirty} uncommitted" if dirty else "")
                     + (f", {ahead} unpushed" if ahead else "") + (", no upstream" if ahead is None else "")))
    rows.sort(key=lambda r: r[0])
    if any(not r[0] for r in rows): lines.append("- (* = branch named in this work item)")
    lines += [r[1] for r in rows[:12]] + ([f"- …{len(rows) - 12} more worktrees"] if len(rows) > 12 else [])
open(out, "w", encoding="utf-8").write("\n".join(lines) + "\n")
PY
  exit 0
}

c="${1:-}"; shift || true
case "$c" in
  attach) cmd_attach "$@" ;;
  new-ticket) cmd_new_ticket "$@" ;;
  log) cmd_log "$@" ;;
  handoff) cmd_handoff "$@" ;;
  rename) cmd_rename "$@" ;;
  close) cmd_close "$@" ;;
  reopen) cmd_reopen "$@" ;;
  show) cmd_show ;;
  index) cmd_index "$@" ;;
  restore) cmd_restore ;;
  snapshot) cmd_snapshot ;;
  *) sed -n '2,21p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
