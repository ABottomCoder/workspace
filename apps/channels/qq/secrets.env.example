# QQ app credentials: business/<co>/.secrets/apps/qq_<name>.env, chmod 600. Never commit, never print.
# The QQ account itself logs in on the protocol endpoint (NapCat: QR scan); these only reach that endpoint.
ONEBOT_HTTP=http://127.0.0.1:3000   # OneBot v11 HTTP server
ONEBOT_WS=ws://127.0.0.1:3001       # OneBot v11 forward WebSocket server
ONEBOT_TOKEN=...                    # access token set on both servers (openssl rand -hex 24)
