#!/bin/bash
# app — run a chat app (bot) from a Claude Code session in the main dir. Channel-agnostic.
#
#   app list [--business <co>]             apps configured on this machine, listener state, ticket
#   app new <co> <channel>_<name>          create business/<co>/apps/<id>/app.yaml from the template
#   app up <id> [--owner <user>]           check config + credentials, write .runtime/, register this
#                                          session as the app's single owner session
#   app run <id>                           write end in the foreground (start as run_in_background)
#                                          — not needed when the service is installed
#   app status [id…] [--live]              listener / heartbeat / read end / verdict per app
#   app down <id>                          stop this session's read end + write end for <id>
#   app send <id> --conv <c> [--thread <ts>] ("text" | --file <p> | --stdin) [--upload <path>]
#   app read <id> <conv> [--peek|--reset]  conversation since the cursor (advances it unless --peek)
#   app inbox <id>                         every event received since the last call
#   app work <id> <ticket> [--title "…"] [--depends t1,t2]   bind the app to a business ticket
#   app log <id> "text"                    append to the current ticket's LOG.md
#   app handoff <id>                       the app's handoff file in the ticket (handoff/<id>.md): create or archive a copy
#   app close <id>                         mark the current ticket closed
#   app name-session <id> <Desc>           name this session <Desc>_<channel>_<name>_<n>
#   app install-service <id> | uninstall-service <id>   (service.<platform>.sh; only on request)
#
# <id> = <channel>_<name> (or just <name> if unique); add --business <co> when ambiguous.
# Layout: config + runtime in business/<co>/apps/<id>/{app.yaml,.runtime/};
#         credentials in business/<co>/.secrets/apps/<id>.env (600); work in business/<co>/tickets/<ID>/.
# Read end (run_in_background, re-run after every wake): apps/bin/wait-event.sh <co>/<id>
set -u
. "$(cd "$(dirname "$0")" && pwd)/lib.sh"

# Pull --business out of any position.
CO=""; ARGS=()
while [ $# -gt 0 ]; do case "$1" in --business) CO=${2:-}; shift 2;; *) ARGS+=("$1"); shift;; esac; done
set -- "${ARGS[@]+"${ARGS[@]}"}"

need_app() { [ -n "${1:-}" ] || die "usage: app $CMD <id>"; resolve_app "$1" "$CO"; }
secrets_file() { echo "$BUSINESS/$APP_CO/.secrets/apps/$APP_ID.env"; }
ticket_dir() { echo "$BUSINESS/$APP_CO/tickets/$1"; }
cur_ticket() { cat "$APP_RUN/ticket" 2>/dev/null; }
need_ticket() { T=$(cur_ticket); [ -n "$T" ] || die "$APP_ID has no current ticket — run: app work $APP_ID <ticket>"; TD=$(ticket_dir "$T"); }
valid_ticket() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die "ticket id must be letters, digits, . _ - (got '$1')"; }
work_tool() { [ -x "$MAIN/tools/work/$1" ] && echo "$MAIN/tools/work/$1"; }

reader_state() {   # ok | busy <s> | deaf
  if pgrep -f "wait-event\.sh ($APP_CO/)?$APP_ID( |\$)" >/dev/null 2>&1; then echo ok; return; fi
  local off="$APP_RUN/.wait-offset" age
  if [ -f "$off" ]; then age=$(( $(date +%s) - $(file_mtime "$off") ))
    [ "$age" -lt "${READER_GRACE:-180}" ] && { echo "busy ${age}s"; return; }; fi
  echo deaf
}

cmd_list() {
  printf "%-14s %-22s %-8s %-8s %s\n" BUSINESS APP CHANNEL LISTENER TICKET
  local f d n
  for f in "$BUSINESS"/${CO:-*}/apps/*/app.yaml; do
    [ -f "$f" ] || continue; d=$(dirname "$f")
    n=$(listener_count "$d/.runtime/listener.log")
    printf "%-14s %-22s %-8s %-8s %s\n" "$(basename "$(dirname "$(dirname "$d")")")" "$(basename "$d")" \
      "$(field "$f" channel)" "$([ "${n:-0}" -gt 0 ] && echo up || echo down)" "$(cat "$d/.runtime/ticket" 2>/dev/null || echo -)"
  done
}

cmd_new() {
  local co=${1:-} id=${2:-}; [ -n "$co" ] && [ -n "$id" ] || die "usage: app new <co> <channel>_<name>"
  [[ "$id" =~ ^[a-z0-9-]+_[a-z0-9][a-z0-9-]*$ ]] || die "app id must be <channel>_<name>, lowercase (got '$id')"
  [ -d "$BUSINESS/$co" ] || die "no business '$co' under $BUSINESS"
  local ch=${id%%_*} home="$BUSINESS/$co/apps/$id"
  [ -d "$(channel_dir "$ch")" ] || die "no channel adapter '$ch' (have: $(ls "$APPS_ROOT/channels" | grep -v README | paste -sd' ' -))"
  [ -f "$home/app.yaml" ] && die "$home/app.yaml exists"
  mkdir -p "$home/.runtime" && chmod 700 "$home/.runtime"
  sed "s/<name>/${id#*_}/g; s/<channel>/$ch/g" "$APPS_ROOT/templates/app.yaml" > "$home/app.yaml"
  echo "created $home/app.yaml — edit listen filters there."
  echo "credentials: $BUSINESS/$co/.secrets/apps/$id.env (format: apps/channels/$ch/secrets.env.example, chmod 600)"
}

cmd_up() {
  need_app "${1:-}"; shift
  local owner=""; while [ $# -gt 0 ]; do case "$1" in --owner) owner=${2:-}; shift 2;; *) die "unknown arg $1";; esac; done
  [ -d "$(channel_dir "$APP_CHANNEL")" ] || die "no channel adapter '$APP_CHANNEL' for $APP_ID"
  [ -d "$APPS_ROOT/node_modules" ] || die "dependencies missing: cd $APPS_ROOT && npm install"
  mkdir -p "$APP_RUN"; chmod 700 "$APP_RUN"
  # Credentials: local file (default) or ssm:<prefix> (materialised into .runtime, 600).
  local src sec; src=$(field "$APP_CONF" secrets); src=${src:-local}; sec=$(secrets_file)
  case "$src" in
    local) [ -f "$sec" ] || die "no credentials for $APP_ID: create $sec (format: apps/channels/$APP_CHANNEL/secrets.env.example), chmod 600"
           chmod 600 "$sec" ;;
    ssm:*) command -v aws >/dev/null || die "secrets come from AWS SSM but the aws CLI is missing"
           sec="$APP_RUN/secrets.env"; local p=${src#ssm:} k; umask 077; : > "$sec"
           for k in $(field "$APP_CONF" ssm_keys); do   # e.g. SLACK_APP_TOKEN=app_token,SLACK_BOT_TOKEN=bot_token
             echo "${k%%=*}=$(aws ssm get-parameter --with-decryption --name "$p/${k#*=}" --query Parameter.Value --output text)" >> "$sec"
           done ;;
    *) die "unknown secrets source '$src' in $APP_CONF" ;;
  esac
  [ -n "$owner" ] || owner=$(cat "$APP_RUN/owner" 2>/dev/null)
  [ -n "$owner" ] || owner=$(field "$APP_CONF" owner)
  [ -n "$owner" ] || die "who owns this session? pass --owner <your chat user id> (only the owner's messages are instructions; RULES.md §2)"
  echo "$owner" > "$APP_RUN/owner"
  ( umask 077; cat > "$APP_RUN/.env" <<EOF
# generated by app up $(now) from $APP_CONF — do not edit, re-run app up
APP_ID=$APP_ID
APP_NAME=$APP_NAME
APP_CHANNEL=$APP_CHANNEL
APP_SECRETS=$sec
APP_OWNER=$owner
APP_LISTEN_TYPES=$(field "$APP_CONF" listen_types)
APP_LISTEN_CONVS=$(field "$APP_CONF" listen_convs)
APP_LISTEN_DM_USERS=$(field "$APP_CONF" listen_dm_users)
APP_ALLOW_BOT_SENDERS=$(field "$APP_CONF" allow_bot_senders)
APP_BOT_EVENT_CAP=$(field "$APP_CONF" bot_event_cap)
APP_ACK_REACTION=$(field "$APP_CONF" ack_reaction)
EOF
  )
  local vc who; vc=$(channel_cmd "$APP_CHANNEL" validate-creds) || die "channel $APP_CHANNEL has no validate-creds"
  ensure_node; who=$(cd "$APP_RUN" && $vc 2>&1) || die "credentials for $APP_ID rejected: $who"
  # One owning session per app.
  local sid=${CLAUDE_CODE_SESSION_ID:-} prev; prev=$(cat "$APP_RUN/.session-id" 2>/dev/null | tr -d '[:space:]')
  if [ -n "$prev" ] && [ "$prev" != "$sid" ] && [ "$(reader_state)" = ok ]; then
    die "$APP_ID is held by session $prev and its read end is running. Stop it there first (app down $APP_ID)."
  fi
  [ -n "$sid" ] && echo "$sid" > "$APP_RUN/.session-id"
  local svc; svc="$APPS_BIN/service.$(service_variant).sh"
  echo "ready: $APP_REF = $who · owner $owner${sid:+ · session $sid}"
  if [ -x "$svc" ] && "$svc" installed "$APP_RUN" >/dev/null 2>&1; then
    "$svc" sync "$APP_RUN" && "$svc" start "$APP_RUN" && echo "write end: under the service manager"
  else
    echo "write end: run_in_background: $APPS_BIN/app run $APP_REF   (or: app install-service $APP_ID)"
  fi
  echo "read end:  run_in_background: $APPS_BIN/wait-event.sh $APP_REF"
  echo "then:      app work $APP_ID <ticket> · app name-session $APP_ID <Desc>"
}

cmd_run() { need_app "${1:-}"; [ -f "$APP_RUN/.env" ] || die "run app up $APP_ID first"; exec "$APPS_BIN/guardian.sh" "$APP_RUN"; }

cmd_status() {
  local live=0 ids=() a; for a in "$@"; do [ "$a" = --live ] && live=1 || ids+=("$a"); done
  if [ ${#ids[@]} -eq 0 ]; then
    for a in "$BUSINESS"/${CO:-*}/apps/*/app.yaml; do [ -f "$a" ] && ids+=("$(basename "$(dirname "$(dirname "$(dirname "$a")")")")/$(basename "$(dirname "$a")")"); done
  fi
  printf "%-26s %-9s %-10s %-9s %-8s %-12s %s\n" APP LISTENER HEARTBEAT READER VERDICT OWNER TICKET
  local rc=0
  for a in "${ids[@]+"${ids[@]}"}"; do
    ( resolve_app "$a" "$CO"
      local log="$APP_RUN/listener.log" n h r v
      n=$(listener_count "$log"); n=${n:-0}; h=$(hb_age "$log"); r=$(reader_state)
      if   [ "$n" -gt 1 ]; then v=SPLIT          # two writers split the event stream: stop one now
      elif [ "$n" -eq 0 ]; then v=DOWN
      elif [ -n "$h" ] && [ "$h" -gt "${DEAF_SECS:-200}" ]; then v=STALE
      elif [ "${r%% *}" = deaf ]; then v=DEAF       # writer fine, nobody reading: messages pile up unanswered
      else v=UP; fi
      printf "%-26s %-9s %-10s %-9s %-8s %-12s %s\n" "$APP_REF" "$n" "${h:+${h}s}${h:+}$([ -z "$h" ] && echo -)" "$r" "$v" \
        "$(cat "$APP_RUN/owner" 2>/dev/null || echo -)" "$(cur_ticket || echo -)"
      if [ "$live" = 1 ]; then vc=$(channel_cmd "$APP_CHANNEL" validate-creds) && ensure_node && echo "    creds: $(cd "$APP_RUN" && $vc 2>&1)"; fi
      [ "$v" = UP ] ) || rc=1
  done
  return $rc
}

cmd_down() {
  need_app "${1:-}"
  local pids svc; pids=$(pgrep -f "guardian\.sh $APP_RUN\$"; pgrep -f "wait-event\.sh ($APP_CO/)?$APP_ID( |\$)")
  [ -n "$pids" ] && kill $pids 2>/dev/null
  svc="$APPS_BIN/service.$(service_variant).sh"
  [ -x "$svc" ] && "$svc" installed "$APP_RUN" >/dev/null 2>&1 && "$svc" stop "$APP_RUN"
  rm -f "$APP_RUN/.session-id"
  echo "stopped $APP_REF (${pids:-no session processes})"
}

chan() {   # <verb> [args…]: run a channel verb from the runtime dir
  local v=$1; shift; local c; c=$(channel_cmd "$APP_CHANNEL" "$v") || die "channel $APP_CHANNEL has no '$v'"
  [ -f "$APP_RUN/.env" ] || die "run app up $APP_ID first"
  ensure_node; cd "$APP_RUN" && exec $c "$@"
}

cmd_work() {
  need_app "${1:-}"; local t=${2:-}; [ -n "$t" ] || die "usage: app work <id> <ticket> [--title …] [--depends …]"; shift 2
  valid_ticket "$t"; local title="" deps=""
  while [ $# -gt 0 ]; do case "$1" in --title) title=${2:-}; shift 2;; --depends) deps=${2:-}; shift 2;; *) die "unknown arg $1";; esac; done
  local d; d=$(ticket_dir "$t"); local tw; tw=$(work_tool attach)
  [ -n "$tw" ] && "$tw" "$APP_CO/tickets/$t" --role "$(printf '%s' "$APP_ID" | tr 'A-Z' 'a-z')" >/dev/null   # the app is a role: its handoff is handoff/<id>.md
  if [ ! -f "$d/STATE.md" ]; then   # fallback when tools/work is absent: create the ticket dir directly
    mkdir -p "$d"/{reports,evidence,history}
    local f; for f in STATE.md LOG.md HANDOFF.md; do
      if [ -f "$MAIN/templates/ticket/$f" ]; then sed "s/<ID>/$t/g" "$MAIN/templates/ticket/$f" > "$d/$f"; fi
    done
    [ -f "$d/STATE.md" ] || printf '# %s\n\nstatus: open\ntitle:\nproject:\napps:\ndepends_on:\ncreated: %s\nupdated:\n' "$t" "$(now)" > "$d/STATE.md"
    [ -f "$d/LOG.md" ] || printf '# %s — log\n\nAppend-only. One line per thing a successor must know.\n\n' "$t" > "$d/LOG.md"
    [ -f "$d/HANDOFF.md" ] || handoff_template "$t" > "$d/HANDOFF.md"
    echo "new ticket dir: $d"
  fi
  [ -z "$title" ] || set_field "$d/STATE.md" title "$title"
  [ "$(field "$d/STATE.md" status)" = active ] || set_field "$d/STATE.md" status active
  local apps all; apps=$(field "$d/STATE.md" apps)
  case ",$apps," in *",$APP_ID,"*) ;; *) set_field "$d/STATE.md" apps "${apps:+$apps,}$APP_ID";; esac
  if [ -n "$deps" ]; then
    all=$(printf '%s\n' $(field "$d/STATE.md" depends_on | tr ',' ' ') ${deps//,/ } | awk 'NF && !s[$0]++' | paste -sd, -)
    set_field "$d/STATE.md" depends_on "$all"
  fi
  set_field "$d/STATE.md" updated "$(now)"; echo "$t" > "$APP_RUN/ticket"
  [ -x "$MAIN/tools/work/index" ] && "$MAIN/tools/work/index" "$APP_CO" >/dev/null 2>&1
  echo "ticket $t [$(field "$d/STATE.md" status)] — read now: $d/STATE.md, $d/HANDOFF.md, end of $d/LOG.md"
  local dep; for dep in $(field "$d/STATE.md" depends_on | tr ',' ' '); do
    [ -f "$(ticket_dir "$dep")/STATE.md" ] && echo "  depends on $dep: $(ticket_dir "$dep")/HANDOFF.md" || echo "  depends on $dep: not on this machine — ask the owner"
  done
}
handoff_template() { printf '# %s — handoff\n\n- Written: <UTC> · app · session\n- Done:\n- In progress:\n- Waiting on:\n- Promised (who / what / when):\n- Next step:\n' "$1"; }

cmd_log() {
  need_app "${1:-}"; local text=${2:-}; [ -n "$text" ] || die "usage: app log <id> \"text\""; need_ticket
  text="[$APP_ID] $(printf '%s' "$text" | tr '\n' ' ')"
  local tw; tw=$(work_tool log); [ -n "$tw" ] && exec "$tw" "$APP_CO/tickets/$T" "$text"
  printf '%s %s\n' "$(now)" "$text" >> "$TD/LOG.md"
  local n; n=$(wc -l < "$TD/LOG.md" | tr -d ' ')
  [ "$n" -gt "${APP_LOG_LIMIT:-300}" ] && echo "app: $TD/LOG.md has $n lines — move older lines to history/ and leave a digest" >&2
  return 0
}

cmd_handoff() {
  need_app "${1:-}"; need_ticket; local tw; tw=$(work_tool handoff); [ -n "$tw" ] && exec "$tw" "$APP_CO/tickets/$T"
  local ts; ts=$(date -u +%Y%m%dT%H%MZ); mkdir -p "$TD/history"
  [ -f "$TD/HANDOFF.md" ] && ! cmp -s "$TD/HANDOFF.md" <(handoff_template "$T") && mv "$TD/HANDOFF.md" "$TD/history/handoff-$ts.md" && echo "archived: history/handoff-$ts.md"
  handoff_template "$T" > "$TD/HANDOFF.md"; echo "write the new handoff into: $TD/HANDOFF.md"
}

cmd_close() {
  need_app "${1:-}"; need_ticket
  set_field "$TD/STATE.md" status closed; set_field "$TD/STATE.md" updated "$(now)"; rm -f "$APP_RUN/ticket"
  echo "ticket $T closed. Publish its summary where the team reads it (ticket system / project docs)."
}

cmd_name_session() {
  need_app "${1:-}"; local desc=${2:-}; [[ "$desc" =~ ^[A-Za-z0-9.-]+$ ]] || die "usage: app name-session <id> <Desc> (Desc: no underscores or spaces)"
  local sid=${CLAUDE_CODE_SESSION_ID:-} dir tp cur n prefix="${desc}_${APP_ID}_"
  dir="$HOME/.claude/projects/$(printf %s "$MAIN" | sed 's/[^A-Za-z0-9]/-/g')"   # Claude Code transcript dir (internal format)
  tp="$dir/$sid.jsonl"
  cur=$( [ -f "$tp" ] && grep '"custom-title"' "$tp" | tail -1 | sed -n 's/.*"customTitle":"\([^"]*\)".*/\1/p')
  if [[ "$cur" == "$prefix"* ]]; then echo "$cur"; return 0; fi
  n=$(grep -ho "\"customTitle\":\"${prefix}[0-9]*\"" "$dir"/*.jsonl 2>/dev/null | sed 's/.*_\([0-9]*\)"$/\1/' | sort -n | tail -1)
  local name="${prefix}$(( ${n:-0} + 1 ))"
  if [ -n "$sid" ] && [ -f "$tp" ]; then
    printf '{"type":"custom-title","customTitle":"%s","sessionId":"%s"}\n' "$name" "$sid" >> "$tp"
    echo "$name"
  else
    echo "$name"; echo "app: transcript not found — ask the user to run: /rename $name" >&2
  fi
}

cmd_service() {   # install|uninstall
  need_app "${2:-}"; local svc; svc="$APPS_BIN/service.$(service_variant).sh"
  [ -x "$svc" ] || die "no service variant for this platform ($(service_variant)); run the write end with: app run $APP_ID"
  [ -f "$APP_RUN/.env" ] || die "run app up $APP_ID first"
  exec "$svc" "$1" "$APP_RUN"
}

CMD=${1:-}; shift 2>/dev/null
case "$CMD" in
  list) cmd_list ;;
  new) cmd_new "$@" ;;
  up) cmd_up "$@" ;;
  run) cmd_run "$@" ;;
  status) cmd_status "$@" ;;
  down) cmd_down "$@" ;;
  send) need_app "${1:-}"; shift; chan send "$@" ;;
  read) need_app "${1:-}"; shift; chan read-since "$@" ;;
  inbox) need_app "${1:-}"; exec "$APPS_BIN/inbox.sh" "$APP_REF" ;;
  work) cmd_work "$@" ;;
  log) cmd_log "$@" ;;
  handoff) cmd_handoff "$@" ;;
  close) cmd_close "$@" ;;
  name-session) cmd_name_session "$@" ;;
  install-service) cmd_service install "$@" ;;
  uninstall-service) cmd_service uninstall "$@" ;;
  *) sed -n '2,27p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
