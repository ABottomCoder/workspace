#!/bin/bash
# botdock — run a shared Slack app from any Claude Code session, with work organised by ticket.
#
#   botdock list                          apps and tickets on this machine
#   botdock up <app> [--owner U…]         create or reuse the app's home, check tokens with Slack,
#                                         refuse if another listener here already uses the app
#   botdock run <app>                     write end: the listener guardian (start as run_in_background)
#   botdock status [app]                  listener / heartbeat / read end, per app
#   botdock down <app>                    stop this machine's listener and read end for <app>
#   botdock work <ticket> [--app <app>] [--title "…"] [--depends t1,t2]
#                                         create or reuse the ticket's folder, link it to the app,
#                                         print what to read (incl. the tickets it depends on)
#   botdock handoff <ticket>              archive the ticket's HANDOFF.md into history/, start a fresh one
#   botdock close <ticket>                mark the ticket done (then publish its summary for the team)
#
# Layout (per machine, never committed), base ~/app_bot (override: BOTDOCK_HOME):
#   slack/<app>/   identity only: bot.yaml, tickets.md (tickets it served), .runtime/ (tokens, log…)
#   work/<ticket>/ the work, whichever app did it: ticket.yaml, CLAUDE.md, HANDOFF.md, data/, history/
#   work/INDEX.md  one line per ticket, regenerated from every ticket.yaml
# Read end (run_in_background, re-run after every wake): bin/wait-event.sh <app>
# Full procedure for Claude: ../CLAUDE.md
set -u
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
BIN="$ROOT/bin"
BASE="${BOTDOCK_HOME:-$HOME/app_bot}"
APPS="$BASE/slack"
WORK="$BASE/work"

die() { echo "botdock: $*" >&2; exit 1; }
now() { date -u +%Y-%m-%dT%H:%MZ; }
# Flat "key: value" reader/writer (no YAML dependency on purpose).
field() { sed -n "s/^$2:[[:space:]]*//p" "$1" | sed 's/[[:space:]]*#.*$//; s/^"\(.*\)"$/\1/' | head -1; }
set_field() {   # <file> <key> <value>  (value may contain anything but newlines)
  python3 - "$1" "$2" "$3" <<'EOF'
import sys, re
p, k, v = sys.argv[1:4]
s = open(p).read()
line = f"{k}: {v}"
s2, n = re.subn(rf"^{re.escape(k)}:.*$", lambda m: line, s, count=1, flags=re.M)
open(p, "w").write(s2 if n else s.rstrip("\n") + "\n" + line + "\n")
EOF
}
conf() { local f="$APPS/$1/bot.yaml"; [ -f "$f" ] || die "no home for app '$1' on this machine — run: botdock up $1"; echo "$f"; }
valid_app() { [[ "$1" =~ ^[a-z0-9][a-z0-9_-]*$ ]] || die "app name must be lowercase letters, digits, - or _ (got '$1')"; }
valid_ticket() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die "ticket id must be letters, digits, . _ - (got '$1')"; }
tpl() { sed "s/<app>/$2/g; s/<ticket>/$3/g" "$ROOT/templates/$1"; }

hb_age() {   # seconds since the newest [heartbeat] in the log, empty if none
  local hb t; hb=$(tail -400 "$1" 2>/dev/null | grep '^\[heartbeat\] ' | tail -1 | sed -E 's/^\[heartbeat\] //; s/\..*$//')
  [ -n "$hb" ] || return 0
  t=$(date -u -jf "%Y-%m-%dT%H:%M:%S" "$hb" +%s 2>/dev/null || date -u -d "$hb" +%s 2>/dev/null) || return 0
  echo $(( $(date -u +%s) - t ))
}

reindex() {   # rebuild work/INDEX.md from every ticket.yaml
  mkdir -p "$WORK"
  { echo "# Tickets on this machine"
    echo
    echo "Generated by botdock from work/*/ticket.yaml — edit those, not this file."
    echo
    echo "| ticket | status | title | apps | depends on | updated |"
    echo "|--------|--------|-------|------|------------|---------|"
    for f in "$WORK"/*/ticket.yaml; do
      [ -f "$f" ] || continue
      printf "| %s | %s | %s | %s | %s | %s |\n" "$(basename "$(dirname "$f")")" "$(field "$f" status)" \
        "$(field "$f" title)" "$(field "$f" apps)" "$(field "$f" depends_on)" "$(field "$f" updated)"
    done; } > "$WORK/INDEX.md"
}

cmd_list() {
  printf "%-12s %-9s %s\n" APP LISTENER "CURRENT TICKET"
  for f in "$APPS"/*/bot.yaml; do
    [ -f "$f" ] || continue
    local a; a=$(basename "$(dirname "$f")"); local l="down"
    lsof "$APPS/$a/.runtime/$a-listener.log" 2>/dev/null | grep -q node && l="up"
    printf "%-12s %-9s %s\n" "$a" "$l" "$(cat "$APPS/$a/.runtime/ticket" 2>/dev/null || echo -)"
  done
  echo; reindex; sed -n '5,$p' "$WORK/INDEX.md"
  echo "(this machine only. Which apps are free company-wide: the claim registry, see TODO.md)"
}

load_secrets() {   # <app> <conf> -> sets APP_TOKEN BOT_TOKEN
  local app=$1 f=$2 src; src=$(field "$f" secrets); src=${src:-local}
  APP_TOKEN=""; BOT_TOKEN=""
  case "$src" in
    local)
      local s="$APPS/$app/.runtime/secrets.env"
      [ -f "$s" ] || die "no tokens for $app: put SLACK_APP_TOKEN=xapp-… and SLACK_BOT_TOKEN=xoxb-… in $s (chmod 600), or set 'secrets: ssm:<prefix>' in its bot.yaml"
      APP_TOKEN=$(sed -n 's/^SLACK_APP_TOKEN=//p' "$s" | tr -d "\"' "); BOT_TOKEN=$(sed -n 's/^SLACK_BOT_TOKEN=//p' "$s" | tr -d "\"' ") ;;
    ssm:*)
      local p=${src#ssm:}; command -v aws >/dev/null || die "secrets come from AWS SSM ($p) but the aws CLI is not installed"
      APP_TOKEN=$(aws ssm get-parameter --with-decryption --name "$p/app_token" --query Parameter.Value --output text 2>/dev/null)
      BOT_TOKEN=$(aws ssm get-parameter --with-decryption --name "$p/bot_token" --query Parameter.Value --output text 2>/dev/null) ;;
    *) die "unknown secrets source '$src' in $f" ;;
  esac
  [[ "$APP_TOKEN" == xapp-* ]] || die "app token for $app missing or not an xapp- token"
  [[ "$BOT_TOKEN" == xoxb-* ]] || die "bot token for $app missing or not an xoxb- token"
}

local_conflict() {   # is any node listener on this machine already using this app token?
  local pid cwd
  for pid in $(pgrep -f "listener.js" 2>/dev/null); do
    cwd=$(lsof -a -p "$pid" -d cwd -Fn 2>/dev/null | grep ^n | cut -c2-)
    [ -n "$cwd" ] && [ -f "$cwd/.env" ] && grep -q "^SLACK_APP_TOKEN=$1" "$cwd/.env" 2>/dev/null && { echo "$pid $cwd"; return 0; }
  done
  return 1
}

cmd_up() {
  local app=${1:-}; [ -n "$app" ] || die "usage: botdock up <app> [--owner <slack_user_id>]"; shift
  local owner=""; while [ $# -gt 0 ]; do case "$1" in --owner) owner=${2:-}; shift 2;; *) die "unknown arg $1";; esac; done
  valid_app "$app"
  local home="$APPS/$app" run="$APPS/$app/.runtime"
  if [ ! -f "$home/bot.yaml" ]; then
    mkdir -p "$run"; chmod 700 "$run"
    tpl bot.yaml "$app" "" > "$home/bot.yaml"
    printf "# Tickets %s worked on (on this machine)\n\n" "$app" > "$home/tickets.md"
    echo "new app home: $home"
  fi
  local f; f=$(conf "$app"); load_secrets "$app" "$f"
  if c=$(local_conflict "$APP_TOKEN"); then
    case "$c" in *" $run") ;; *) die "this app token is already in use by another listener on this machine (pid/cwd: $c). Two listeners split the event stream — stop that one first.";; esac
  fi
  local who; who=$(cd "$BIN" && T="$BOT_TOKEN" node --input-type=module -e '
    const {WebClient} = await import("@slack/web-api");
    const r = await new WebClient(process.env.T).auth.test().catch(e => ({ok:false,error:e.data?.error||e.message}));
    console.log(r.ok ? `${r.user} ${r.user_id} in ${r.team}` : `ERROR ${r.error}`);')
  case "$who" in ERROR*|"") die "Slack rejected the bot token for $app: ${who:-no answer}";; esac
  [ -n "$owner" ] || owner=$(cat "$run/owner" 2>/dev/null)
  [ -n "$owner" ] || die "who owns this session? pass --owner <your Slack user id U…> (only the owner's messages are instructions; see RULES.md)"
  [[ "$owner" == U* ]] || die "--owner must be a Slack user id (U…), got '$owner'"
  echo "$owner" > "$run/owner"
  umask 077
  cat > "$run/.env" <<EOF
# generated by botdock up $(now) from $home/bot.yaml — do not edit, re-run botdock up
BOT_NAME=$app
SLACK_APP_TOKEN=$APP_TOKEN
SLACK_BOT_TOKEN=$BOT_TOKEN
MONITOR_ALLOW_TYPES=$(field "$f" listen_types)
MONITOR_ALLOW_CHANNELS=$(field "$f" listen_channels)
MONITOR_ALLOW_DM_USERS=$(field "$f" listen_dm_users)
MONITOR_ALLOW_BOT_SENDERS=$(field "$f" allow_bot_senders)
MONITOR_BOT_EVENT_CAP=$(field "$f" bot_event_cap)
EOF
  echo "ready: $app = $who · owner $owner · home $home"
  echo "next, in the Claude session:"
  echo "  1. botdock work <ticket> --app $app      (which ticket is this session for?)"
  echo "  2. run_in_background: $BIN/botdock run $app"
  echo "  3. run_in_background: $BIN/wait-event.sh $app"
  echo "  4. echo \"\$CLAUDE_CODE_SESSION_ID\" > $run/.session-id   (enables the Stop-hook guard, if installed)"
}

cmd_work() {
  local t=${1:-}; [ -n "$t" ] || die "usage: botdock work <ticket> [--app <app>] [--title \"…\"] [--depends t1,t2]"; shift
  local app="" title="" deps=""
  while [ $# -gt 0 ]; do case "$1" in
    --app) app=${2:-}; shift 2;; --title) title=${2:-}; shift 2;; --depends) deps=${2:-}; shift 2;;
    *) die "unknown arg $1";; esac; done
  valid_ticket "$t"; [ -z "$app" ] || conf "$app" >/dev/null
  local x; for x in ${deps//,/ }; do valid_ticket "$x"; done
  local d="$WORK/$t" y="$WORK/$t/ticket.yaml"
  if [ ! -f "$y" ]; then
    mkdir -p "$d/data" "$d/history"
    tpl ticket.yaml "" "$t" > "$y"; set_field "$y" created "$(now)"
    tpl ticket-CLAUDE.md "" "$t" > "$d/CLAUDE.md"
    tpl HANDOFF.md "" "$t" > "$d/HANDOFF.md"
    echo "new ticket folder: $d"
  fi
  [ -z "$title" ] || set_field "$y" title "$title"
  if [ -n "$deps" ]; then
    local cur all; cur=$(field "$y" depends_on)
    all=$(printf '%s\n' ${cur//,/ } ${deps//,/ } | awk 'NF && !s[$0]++' | paste -sd, -)
    set_field "$y" depends_on "$all"
  fi
  if [ -n "$app" ]; then
    local apps; apps=$(field "$y" apps); case ",$apps," in *",$app,"*) ;; *) set_field "$y" apps "${apps:+$apps,}$app";; esac
    grep -q "^- $t\$" "$APPS/$app/tickets.md" 2>/dev/null || echo "- $t" >> "$APPS/$app/tickets.md"
    echo "$t" > "$APPS/$app/.runtime/ticket"
  fi
  set_field "$y" updated "$(now)"; reindex
  echo "ticket $t: $(field "$y" title) [$(field "$y" status)] apps=$(field "$y" apps)"
  echo "read now:"
  echo "  $d/CLAUDE.md"
  echo "  $d/HANDOFF.md"
  local dep
  for dep in $(field "$y" depends_on | tr ',' ' '); do
    if [ -f "$WORK/$dep/ticket.yaml" ]; then
      echo "  depends on $dep [$(field "$WORK/$dep/ticket.yaml" status)]: $WORK/$dep/CLAUDE.md and $WORK/$dep/HANDOFF.md"
    else
      echo "  depends on $dep: NOT on this machine — ask the owner, or read its published summary (ticket system / docs)"
    fi
  done
}

cmd_handoff() {
  local t=${1:-}; [ -n "$t" ] || die "usage: botdock handoff <ticket>"; valid_ticket "$t"
  local d="$WORK/$t" ts; [ -f "$d/ticket.yaml" ] || die "no ticket folder for $t"; ts=$(date -u +%Y%m%dT%H%MZ)
  if [ -f "$d/HANDOFF.md" ] && ! cmp -s "$d/HANDOFF.md" <(tpl HANDOFF.md "" "$t"); then
    mv "$d/HANDOFF.md" "$d/history/handoff-$ts.md"; echo "archived: $d/history/handoff-$ts.md"
  fi
  tpl HANDOFF.md "" "$t" > "$d/HANDOFF.md"; set_field "$d/ticket.yaml" updated "$(now)"; reindex
  echo "write the new handoff into: $d/HANDOFF.md"
}

cmd_close() {
  local t=${1:-}; [ -n "$t" ] || die "usage: botdock close <ticket>"; valid_ticket "$t"
  local y="$WORK/$t/ticket.yaml"; [ -f "$y" ] || die "no ticket folder for $t"
  set_field "$y" status done; set_field "$y" updated "$(now)"; reindex
  echo "ticket $t closed. Publish its summary where the team can read it (ticket system / project docs) — this folder exists only on this machine."
}

cmd_run() { local app=${1:-}; [ -n "$app" ] || die "usage: botdock run <app>"; conf "$app" >/dev/null; exec "$BIN/guardian.sh" "$app"; }

cmd_status() {
  local apps=("$@"); [ ${#apps[@]} -gt 0 ] || apps=($(ls "$APPS" 2>/dev/null))
  printf "%-12s %-9s %-10s %-7s %-12s %s\n" APP LISTENER HEARTBEAT READER OWNER TICKET
  for a in "${apps[@]}"; do
    local run="$APPS/$a/.runtime" log="$APPS/$a/.runtime/$a-listener.log" l="down" h r="✗"
    [ -d "$run" ] || continue
    lsof "$log" 2>/dev/null | grep -q node && l="up"
    h=$(hb_age "$log"); h=${h:+${h}s ago}; h=${h:--}
    pgrep -f "wait-event\.sh $a( |\$)" >/dev/null 2>&1 && r="✓"
    printf "%-12s %-9s %-10s %-9s %-12s %s\n" "$a" "$l" "$h" "$r" "$(cat "$run/owner" 2>/dev/null || echo -)" "$(cat "$run/ticket" 2>/dev/null || echo -)"
  done
}

cmd_down() {
  local app=${1:-}; [ -n "$app" ] || die "usage: botdock down <app>"
  local pids; pids=$(pgrep -f "guardian\.sh $app\$"; pgrep -f "wait-event\.sh $app( |\$)")
  [ -n "$pids" ] && kill $pids 2>/dev/null
  rm -f "$APPS/$app/.runtime/.session-id" "$APPS/$app/.runtime/ticket"
  echo "stopped $app on this machine (${pids:-nothing was running})"
}

case "${1:-}" in
  list) cmd_list ;;
  up) shift; cmd_up "$@" ;;
  run) shift; cmd_run "$@" ;;
  status) shift; cmd_status "$@" ;;
  down) shift; cmd_down "$@" ;;
  work) shift; cmd_work "$@" ;;
  handoff) shift; cmd_handoff "$@" ;;
  close) shift; cmd_close "$@" ;;
  *) sed -n '2,21p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
