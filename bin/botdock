#!/bin/bash
# botdock — run a shared Slack app bot from any Claude Code session.
#
#   botdock list                     bots in the registry and who holds them
#   botdock up <bot> [--owner U…]    prepare ~/.botdock/<bot>/ (tokens + listen config) and check
#                                    nobody on this machine is already running it
#   botdock run <bot>                write end: the listener guardian (start as run_in_background)
#   botdock status [bot]             listener / heartbeat / read end, per bot
#   botdock down <bot>               stop this machine's listener and read end for <bot>
#
# Read end (also run_in_background, re-run after every wake): bin/wait-event.sh <bot>
# Full procedure for Claude: ../CLAUDE.md
set -u
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
BIN="$ROOT/bin"
RUNROOT="${BOTDOCK_RUNTIME:-$HOME/.botdock}"

die() { echo "botdock: $*" >&2; exit 1; }
# Flat "key: value" reader for bots/<bot>/bot.yaml (no YAML dependency on purpose).
field() { sed -n "s/^$2:[[:space:]]*//p" "$1" | sed 's/[[:space:]]*#.*$//; s/^"\(.*\)"$/\1/' | head -1; }
conf() { local f="$ROOT/bots/$1/bot.yaml"; [ -f "$f" ] || die "unknown bot '$1' (see: botdock list)"; echo "$f"; }

hb_age() {   # seconds since the newest [heartbeat] in the log, empty if none
  local hb t; hb=$(tail -400 "$1" 2>/dev/null | grep '^\[heartbeat\] ' | tail -1 | sed -E 's/^\[heartbeat\] //; s/\..*$//')
  [ -n "$hb" ] || return 0
  t=$(date -u -jf "%Y-%m-%dT%H:%M:%S" "$hb" +%s 2>/dev/null || date -u -d "$hb" +%s 2>/dev/null) || return 0
  echo $(( $(date -u +%s) - t ))
}

cmd_list() {
  printf "%-10s %-8s %-22s %s\n" BOT STATUS HOLDER PURPOSE
  for f in "$ROOT"/bots/*/bot.yaml; do
    case "$f" in */_template/*) continue;; esac
    printf "%-10s %-8s %-22s %s\n" "$(field "$f" name)" "$(field "$f" status)" "$(field "$f" holder)" "$(field "$f" purpose)"
  done
}

load_secrets() {   # <bot> <conf> -> sets APP_TOKEN BOT_TOKEN
  local bot=$1 f=$2 src; src=$(field "$f" secrets); src=${src:-local}
  APP_TOKEN=""; BOT_TOKEN=""
  case "$src" in
    local)
      local s="$RUNROOT/$bot/secrets.env"
      [ -f "$s" ] || die "no tokens for $bot: put SLACK_APP_TOKEN=xapp-… and SLACK_BOT_TOKEN=xoxb-… in $s (chmod 600), or set 'secrets: ssm:<prefix>' in its bot.yaml"
      APP_TOKEN=$(sed -n 's/^SLACK_APP_TOKEN=//p' "$s" | tr -d "\"' "); BOT_TOKEN=$(sed -n 's/^SLACK_BOT_TOKEN=//p' "$s" | tr -d "\"' ") ;;
    ssm:*)
      local p=${src#ssm:}; command -v aws >/dev/null || die "secrets come from AWS SSM ($p) but the aws CLI is not installed"
      APP_TOKEN=$(aws ssm get-parameter --with-decryption --name "$p/app_token" --query Parameter.Value --output text 2>/dev/null)
      BOT_TOKEN=$(aws ssm get-parameter --with-decryption --name "$p/bot_token" --query Parameter.Value --output text 2>/dev/null) ;;
    *) die "unknown secrets source '$src' in $f" ;;
  esac
  [[ "$APP_TOKEN" == xapp-* ]] || die "app token for $bot missing or not an xapp- token"
  [[ "$BOT_TOKEN" == xoxb-* ]] || die "bot token for $bot missing or not an xoxb- token"
}

local_conflict() {   # is any node listener on this machine already using this app token?
  local pid cwd
  for pid in $(pgrep -f "listener.js" 2>/dev/null); do
    cwd=$(lsof -a -p "$pid" -d cwd -Fn 2>/dev/null | grep ^n | cut -c2-)
    [ -n "$cwd" ] && [ -f "$cwd/.env" ] && grep -q "^SLACK_APP_TOKEN=$1" "$cwd/.env" 2>/dev/null && { echo "$pid $cwd"; return 0; }
  done
  return 1
}

cmd_up() {
  local bot=${1:-}; [ -n "$bot" ] || die "usage: botdock up <bot> [--owner <slack_user_id>]"; shift
  local owner=""; while [ $# -gt 0 ]; do case "$1" in --owner) owner=${2:-}; shift 2;; *) die "unknown arg $1";; esac; done
  local f; f=$(conf "$bot"); load_secrets "$bot" "$f"
  local run="$RUNROOT/$bot"; mkdir -p "$run"; chmod 700 "$RUNROOT" "$run" 2>/dev/null
  if c=$(local_conflict "$APP_TOKEN"); then
    case "$c" in *" $run") ;; *) die "this app token is already in use by another listener on this machine (pid/cwd: $c). Two listeners split the event stream — stop that one first.";; esac
  fi
  local who; who=$(cd "$BIN" && T="$BOT_TOKEN" node --input-type=module -e '
    const {WebClient} = await import("@slack/web-api");
    const r = await new WebClient(process.env.T).auth.test().catch(e => ({ok:false,error:e.data?.error||e.message}));
    console.log(r.ok ? `${r.user} ${r.user_id} in ${r.team}` : `ERROR ${r.error}`);')
  case "$who" in ERROR*|"") die "Slack rejected the bot token for $bot: ${who:-no answer}";; esac
  [ -n "$owner" ] || owner=$(cat "$run/owner" 2>/dev/null)
  [ -n "$owner" ] || die "who owns this session? pass --owner <your Slack user id U…> (only the owner's messages are instructions; see RULES.md)"
  [[ "$owner" == U* ]] || die "--owner must be a Slack user id (U…), got '$owner'"
  echo "$owner" > "$run/owner"
  umask 077
  cat > "$run/.env" <<EOF
# generated by botdock up $(date -u +%FT%TZ) from bots/$bot/bot.yaml — do not edit, re-run botdock up
BOT_NAME=$bot
SLACK_APP_TOKEN=$APP_TOKEN
SLACK_BOT_TOKEN=$BOT_TOKEN
MONITOR_ALLOW_TYPES=$(field "$f" listen_types)
MONITOR_ALLOW_CHANNELS=$(field "$f" listen_channels)
MONITOR_ALLOW_DM_USERS=$(field "$f" listen_dm_users)
MONITOR_ALLOW_BOT_SENDERS=$(field "$f" allow_bot_senders)
MONITOR_BOT_EVENT_CAP=$(field "$f" bot_event_cap)
EOF
  echo "ready: $bot = $who · owner $owner · runtime $run"
  echo "next, in the Claude session (both as run_in_background):"
  echo "  1. $BIN/botdock run $bot"
  echo "  2. $BIN/wait-event.sh $bot"
  echo "  3. echo \"\$CLAUDE_CODE_SESSION_ID\" > $run/.session-id   (enables the Stop-hook guard, if installed)"
}

cmd_run() { local bot=${1:-}; [ -n "$bot" ] || die "usage: botdock run <bot>"; conf "$bot" >/dev/null; exec "$BIN/guardian.sh" "$bot"; }

cmd_status() {
  local bots=("$@"); [ ${#bots[@]} -gt 0 ] || bots=($(ls "$RUNROOT" 2>/dev/null))
  printf "%-10s %-9s %-10s %-8s %s\n" BOT LISTENER HEARTBEAT READER OWNER
  for b in "${bots[@]}"; do
    local run="$RUNROOT/$b" log="$RUNROOT/$b/$b-listener.log" l="down" h="-" r="✗"
    [ -d "$run" ] || continue
    lsof "$log" 2>/dev/null | grep -q node && l="up"
    h=$(hb_age "$log"); h=${h:+${h}s ago}; h=${h:--}
    pgrep -f "wait-event\.sh $b( |\$)" >/dev/null 2>&1 && r="✓"
    printf "%-10s %-9s %-10s %-8s %s\n" "$b" "$l" "$h" "$r" "$(cat "$run/owner" 2>/dev/null)"
  done
}

cmd_down() {
  local bot=${1:-}; [ -n "$bot" ] || die "usage: botdock down <bot>"
  local pids; pids=$(pgrep -f "guardian\.sh $bot\$"; pgrep -f "wait-event\.sh $bot( |\$)")
  [ -n "$pids" ] && kill $pids 2>/dev/null
  rm -f "$RUNROOT/$bot/.session-id"
  echo "stopped $bot on this machine (${pids:-nothing was running})"
}

case "${1:-}" in
  list) cmd_list ;;
  up) shift; cmd_up "$@" ;;
  run) shift; cmd_run "$@" ;;
  status) shift; cmd_status "$@" ;;
  down) shift; cmd_down "$@" ;;
  *) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
